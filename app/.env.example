# CoinMarketCap Pro API key (free Basic plan is enough): https://pro.coinmarketcap.com
CMC_API_KEY=
# Atlas Oracle API key (self-service portal: https://atlasoracle.io): signed prices + consensus health
ATLAS_API_KEY=
# Optional: RPCs (defaults: publicnode)
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Optional: where the real share price and US market hours come from (default: CoAgentic Markets public feed)
# COAGENTIC_FEED_BASE=https://tv.coagentic.markets

# Recording verdicts on-chain (all optional; without them the page is read-only)
# The CatVerdicts contract on BSC testnet (deployed by contracts/script/DeployCatVerdicts.s.sol)
NEXT_PUBLIC_CAT_VERDICTS_ADDRESS=0x0768597770EDF130B59a9661495d1cbAF8904bB4
# The attester's private key (TESTNET ONLY), and the secret that protects the record route
CAT_ATTESTER_KEY=
CRON_SECRET=
